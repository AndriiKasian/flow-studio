# Flow Studio web environment variables.
# Copy to apps/web/.env.local for local development. Never commit real values.
# In production (Vercel), set these in Project Settings -> Environment Variables.
# Both are server-side only; do not prefix them with NEXT_PUBLIC_.

# Required everywhere. Base URL of the Express API, called by the Next.js server
# (server components, server actions and the /api/* proxy routes).
API_URL="http://localhost:3001"
# Production (Render), for example:
# API_URL="https://your-api.onrender.com"

# Required in production; optional locally. Must match TRUSTED_PROXY_SECRET on
# the API. Sent with the visitor IP so the API can apply per-visitor limits and
# accept demo runs.
# TRUSTED_PROXY_SECRET="replace-with-a-long-random-secret"
