# Flow Studio API environment variables.
# Copy to apps/api/.env for local development. Never commit real values.
# In production (Render), set these in the service's Environment settings;
# no .env file is used there.

# --- Database ---------------------------------------------------------------

# Required everywhere. Runtime connection used by Prisma (PrismaPg adapter) and,
# unless overridden for a command, by the Prisma CLI (prisma7.config.ts).
# Local (docker compose):
DATABASE_URL="postgresql://flow_studio:flow_studio@localhost:5432/flow_studio"
# Production (Neon), pooled connection string, for example:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Local tests only. API tests run against this database; its name must be
# exactly flow_studio_test and differ from DATABASE_URL (see vitest.config.ts).
TEST_DATABASE_URL="postgresql://flow_studio:flow_studio@localhost:5432/flow_studio_test"

# --- Server -----------------------------------------------------------------

# Optional. Defaults to 3001. Render provides PORT automatically.
# PORT=3001

# NODE_ENV: do not set it here. `pnpm dev:api` sets development and Vitest sets
# test. Any other value (including unset) enables production protections:
# rate limits, the demo proxy requirement, graph sandboxing and log redaction.

# Required in production; optional locally (defaults to http://localhost:3000).
# The web app's public origin, used for CORS. The API refuses to start outside
# local development when it is missing.
# FRONTEND_URL="https://your-web-app.vercel.app"

# Required in production; optional locally. Shared secret proving requests come
# from the Next.js server. Must match TRUSTED_PROXY_SECRET in the web app.
# Without it, demo runs return 503 and per-visitor rate limits cannot use the
# forwarded visitor IP. Generate with: openssl rand -hex 32
# TRUSTED_PROXY_SECRET="replace-with-a-long-random-secret"

# --- Paid providers -----------------------------------------------------------

# Local development only. Set to "true" to execute LLM and Web Search nodes in
# your own workflows. Never set in production: public workflows are limited to
# free, deterministic node types. The protected demo does not need it.
# ALLOW_PAID_FLOW_NODES="true"

# Required for the demo's LLM node (and local LLM nodes). Both must be set.
OPENAI_API_KEY="replace-with-your-openai-api-key"
OPENAI_MODEL="replace-with-an-openai-model-id"

# Required for the demo's Web Search node (and local Web Search nodes).
SERPER_API_KEY="replace-with-your-serper-api-key"
