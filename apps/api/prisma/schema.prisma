generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Flow {
  id          String   @id @default(uuid())
  name        String
  description String?
  graph       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DemoQuota {
  id              String   @id
  runsUsed        Int      @default(0)
  windowStartedAt DateTime @default(now())
}
